<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" id="DPP_readiness_step__Figure_9c_" name="DPP readiness step (Figure 9c)" namespace="http://dpp-prep.thesis/DPP_readiness_step__Figure_9c_">
  <inputData id="in_Condition" name="Condition"><variable id="v_in_Condition" name="Condition" typeRef="string"/></inputData>
  <inputData id="in_Quality_criterion_configured" name="Quality criterion configured"><variable id="v_in_Quality_criterion_configured" name="Quality criterion configured" typeRef="boolean"/></inputData>
  <inputData id="in_Approval_statement" name="Approval statement"><variable id="v_in_Approval_statement" name="Approval statement" typeRef="string"/></inputData>
  <inputData id="in_Validity_statement" name="Validity statement"><variable id="v_in_Validity_statement" name="Validity statement" typeRef="string"/></inputData>
