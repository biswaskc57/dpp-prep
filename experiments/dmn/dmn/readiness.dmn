  <decision id="d_Applicability" name="Applicability">
    <variable id="v_d_Applicability" name="Applicability" typeRef="string"/>
    <informationRequirement id="ir_d_Applicability_Condition"><requiredInput href="#in_Condition"/></informationRequirement>
    <informationRequirement id="ir_d_Applicability_Quality_criterion_configured"><requiredInput href="#in_Quality_criterion_configured"/></informationRequirement>
    <informationRequirement id="ir_d_Applicability_Approval_statement"><requiredInput href="#in_Approval_statement"/></informationRequirement>
    <informationRequirement id="ir_d_Applicability_Validity_statement"><requiredInput href="#in_Validity_statement"/></informationRequirement>
    <informationRequirement id="ir_d_Applicability_Quality_statement"><requiredInput href="#in_Quality_statement"/></informationRequirement>
    <decisionTable id="t_d_Applicability" hitPolicy="FIRST">
      <input id="i_d_Applicability_0" label="Condition"><inputExpression id="e_d_Applicability_0" typeRef="string"><text>Condition</text></inputExpression></input>
      <input id="i_d_Applicability_1" label="Quality criterion configured"><inputExpression id="e_d_Applicability_1" typeRef="boolean"><text>Quality criterion configured</text></inputExpression></input>
      <input id="i_d_Applicability_2" label="Approval statement"><inputExpression id="e_d_Applicability_2" typeRef="string"><text>Approval statement</text></inputExpression></input>
      <input id="i_d_Applicability_3" label="Validity statement"><inputExpression id="e_d_Applicability_3" typeRef="string"><text>Validity statement</text></inputExpression></input>
      <input id="i_d_Applicability_4" label="Quality statement"><inputExpression id="e_d_Applicability_4" typeRef="string"><text>Quality statement</text></inputExpression></input>
      <output id="o_d_Applicability" name="Applicability" typeRef="string"/>
      <rule id="r_A1"><description>A1</description>
        <inputEntry id="ie_A1_0"><text>"Available","Aligned","Representable","Evidenced","Validated"</text></inputEntry>
        <inputEntry id="ie_A1_1"><text>-</text></inputEntry>
        <inputEntry id="ie_A1_2"><text>-</text></inputEntry>
        <inputEntry id="ie_A1_3"><text>-</text></inputEntry>
        <inputEntry id="ie_A1_4"><text>-</text></inputEntry>
        <outputEntry id="oe_A1"><text>"applicable"</text></outputEntry></rule>
      <rule id="r_A2"><description>A2</description>
        <inputEntry id="ie_A2_0"><text>"Of sufficient quality"</text></inputEntry>
        <inputEntry id="ie_A2_1"><text>true</text></inputEntry>
        <inputEntry id="ie_A2_2"><text>-</text></inputEntry>
        <inputEntry id="ie_A2_3"><text>-</text></inputEntry>
        <inputEntry id="ie_A2_4"><text>-</text></inputEntry>
        <outputEntry id="oe_A2"><text>"applicable"</text></outputEntry></rule>
      <rule id="r_A3"><description>A3</description>
        <inputEntry id="ie_A3_0"><text>"Of sufficient quality"</text></inputEntry>
        <inputEntry id="ie_A3_1"><text>false</text></inputEntry>
        <inputEntry id="ie_A3_2"><text>-</text></inputEntry>
        <inputEntry id="ie_A3_3"><text>-</text></inputEntry>
        <inputEntry id="ie_A3_4"><text>"stated not required"</text></inputEntry>
        <outputEntry id="oe_A3"><text>"not applicable"</text></outputEntry></rule>
      <rule id="r_A4"><description>A4</description>
        <inputEntry id="ie_A4_0"><text>"Authorised"</text></inputEntry>
        <inputEntry id="ie_A4_1"><text>-</text></inputEntry>
        <inputEntry id="ie_A4_2"><text>"stated required"</text></inputEntry>
        <inputEntry id="ie_A4_3"><text>-</text></inputEntry>
        <inputEntry id="ie_A4_4"><text>-</text></inputEntry>
        <outputEntry id="oe_A4"><text>"applicable"</text></outputEntry></rule>
      <rule id="r_A5"><description>A5</description>
        <inputEntry id="ie_A5_0"><text>"Authorised"</text></inputEntry>
        <inputEntry id="ie_A5_1"><text>-</text></inputEntry>
        <inputEntry id="ie_A5_2"><text>"stated not required"</text></inputEntry>
        <inputEntry id="ie_A5_3"><text>-</text></inputEntry>
        <inputEntry id="ie_A5_4"><text>-</text></inputEntry>
        <outputEntry id="oe_A5"><text>"not applicable"</text></outputEntry></rule>
      <rule id="r_A6"><description>A6</description>
        <inputEntry id="ie_A6_0"><text>"Current"</text></inputEntry>
        <inputEntry id="ie_A6_1"><text>-</text></inputEntry>
        <inputEntry id="ie_A6_2"><text>-</text></inputEntry>
        <inputEntry id="ie_A6_3"><text>"stated required"</text></inputEntry>
        <inputEntry id="ie_A6_4"><text>-</text></inputEntry>
        <outputEntry id="oe_A6"><text>"applicable"</text></outputEntry></rule>
      <rule id="r_A7"><description>A7</description>
        <inputEntry id="ie_A7_0"><text>"Current"</text></inputEntry>
        <inputEntry id="ie_A7_1"><text>-</text></inputEntry>
        <inputEntry id="ie_A7_2"><text>-</text></inputEntry>
        <inputEntry id="ie_A7_3"><text>"stated not required"</text></inputEntry>
        <inputEntry id="ie_A7_4"><text>-</text></inputEntry>
        <outputEntry id="oe_A7"><text>"not applicable"</text></outputEntry></rule>
      <rule id="r_A8"><description>A8</description>
        <inputEntry id="ie_A8_0"><text>-</text></inputEntry>
        <inputEntry id="ie_A8_1"><text>-</text></inputEntry>
        <inputEntry id="ie_A8_2"><text>-</text></inputEntry>
        <inputEntry id="ie_A8_3"><text>-</text></inputEntry>
        <inputEntry id="ie_A8_4"><text>-</text></inputEntry>
        <outputEntry id="oe_A8"><text>"cannot yet determine"</text></outputEntry></rule>
    </decisionTable>
  </decision>
  <decision id="d_Available_status" name="Available status">
    <variable id="v_d_Available_status" name="Available status" typeRef="string"/>
    <informationRequirement id="ir_d_Available_status_Supported_proposal_exists"><requiredInput href="#in_Supported_proposal_exists"/></informationRequirement>
    <informationRequirement id="ir_d_Available_status_Not_in_sources_and_obtain_failed"><requiredInput href="#in_Not_in_sources_and_obtain_failed"/></informationRequirement>
    <decisionTable id="t_d_Available_status" hitPolicy="UNIQUE">
      <input id="i_d_Available_status_0" label="Supported proposal exists"><inputExpression id="e_d_Available_status_0" typeRef="boolean"><text>Supported proposal exists</text></inputExpression></input>
      <input id="i_d_Available_status_1" label="Not in sources and obtain failed"><inputExpression id="e_d_Available_status_1" typeRef="boolean"><text>Not in sources and obtain failed</text></inputExpression></input>
      <output id="o_d_Available_status" name="Available status" typeRef="string"/>
      <rule id="r_AV1"><description>AV1</description>
        <inputEntry id="ie_AV1_0"><text>true</text></inputEntry>
        <inputEntry id="ie_AV1_1"><text>-</text></inputEntry>
        <outputEntry id="oe_AV1"><text>"met"</text></outputEntry></rule>
      <rule id="r_AV2"><description>AV2</description>
        <inputEntry id="ie_AV2_0"><text>false</text></inputEntry>
        <inputEntry id="ie_AV2_1"><text>true</text></inputEntry>
        <outputEntry id="oe_AV2"><text>"not met"</text></outputEntry></rule>
      <rule id="r_AV3"><description>AV3</description>
        <inputEntry id="ie_AV3_0"><text>false</text></inputEntry>
        <inputEntry id="ie_AV3_1"><text>false</text></inputEntry>
        <outputEntry id="oe_AV3"><text>"not yet assessed"</text></outputEntry></rule>
    </decisionTable>
  </decision>
  <decision id="d_Quality_status" name="Quality status">
    <variable id="v_d_Quality_status" name="Quality status" typeRef="string"/>
    <informationRequirement id="ir_d_Quality_status_Number_of_criteria"><requiredInput href="#in_Number_of_criteria"/></informationRequirement>
    <informationRequirement id="ir_d_Quality_status_Failed_criteria"><requiredInput href="#in_Failed_criteria"/></informationRequirement>
    <informationRequirement id="ir_d_Quality_status_Insufficient_criteria"><requiredInput href="#in_Insufficient_criteria"/></informationRequirement>
    <decisionTable id="t_d_Quality_status" hitPolicy="FIRST">
      <input id="i_d_Quality_status_0" label="Number of criteria"><inputExpression id="e_d_Quality_status_0" typeRef="number"><text>Number of criteria</text></inputExpression></input>
      <input id="i_d_Quality_status_1" label="Failed criteria"><inputExpression id="e_d_Quality_status_1" typeRef="number"><text>Failed criteria</text></inputExpression></input>
      <input id="i_d_Quality_status_2" label="Insufficient criteria"><inputExpression id="e_d_Quality_status_2" typeRef="number"><text>Insufficient criteria</text></inputExpression></input>
      <output id="o_d_Quality_status" name="Quality status" typeRef="string"/>
      <rule id="r_B_agg_4"><description>B-agg-4</description>
        <inputEntry id="ie_B_agg_4_0"><text>0</text></inputEntry>
        <inputEntry id="ie_B_agg_4_1"><text>-</text></inputEntry>
        <inputEntry id="ie_B_agg_4_2"><text>-</text></inputEntry>
        <outputEntry id="oe_B_agg_4"><text>"no criteria"</text></outputEntry></rule>
      <rule id="r_B_agg_1"><description>B-agg-1</description>
        <inputEntry id="ie_B_agg_1_0"><text>-</text></inputEntry>
        <inputEntry id="ie_B_agg_1_1"><text>&gt;0</text></inputEntry>
        <inputEntry id="ie_B_agg_1_2"><text>-</text></inputEntry>
        <outputEntry id="oe_B_agg_1"><text>"not met"</text></outputEntry></rule>
      <rule id="r_B_agg_2"><description>B-agg-2</description>
        <inputEntry id="ie_B_agg_2_0"><text>-</text></inputEntry>
        <inputEntry id="ie_B_agg_2_1"><text>-</text></inputEntry>
        <inputEntry id="ie_B_agg_2_2"><text>&gt;0</text></inputEntry>
        <outputEntry id="oe_B_agg_2"><text>"not yet assessed"</text></outputEntry></rule>
      <rule id="r_B_agg_3"><description>B-agg-3</description>
        <inputEntry id="ie_B_agg_3_0"><text>-</text></inputEntry>
        <inputEntry id="ie_B_agg_3_1"><text>-</text></inputEntry>
        <inputEntry id="ie_B_agg_3_2"><text>-</text></inputEntry>
        <outputEntry id="oe_B_agg_3"><text>"met"</text></outputEntry></rule>
    </decisionTable>
  </decision>
  <decision id="d_Condition_status" name="Condition status">
    <variable id="v_d_Condition_status" name="Condition status" typeRef="string"/>
    <informationRequirement id="ir_d_Condition_status_Condition"><requiredInput href="#in_Condition"/></informationRequirement>
    <informationRequirement id="ir_d_Condition_status_Alignment_checks"><requiredInput href="#in_Alignment_checks"/></informationRequirement>
    <informationRequirement id="ir_d_Condition_status_Value_type_check"><requiredInput href="#in_Value_type_check"/></informationRequirement>
    <informationRequirement id="ir_d_Condition_status_Support_check"><requiredInput href="#in_Support_check"/></informationRequirement>
    <informationRequirement id="ir_d_Condition_status_Evidence_inspected"><requiredInput href="#in_Evidence_inspected"/></informationRequirement>
    <informationRequirement id="ir_d_Condition_status_All_configured_checks"><requiredInput href="#in_All_configured_checks"/></informationRequirement>
    <informationRequirement id="ir_d_Condition_status_Approval_on_this_version"><requiredInput href="#in_Approval_on_this_version"/></informationRequirement>
    <informationRequirement id="ir_d_Condition_status_Source_validity"><requiredInput href="#in_Source_validity"/></informationRequirement>
    <informationRequirement id="ir_d_Condition_status_Applicability"><requiredDecision href="#d_Applicability"/></informationRequirement>
    <informationRequirement id="ir_d_Condition_status_Available_status"><requiredDecision href="#d_Available_status"/></informationRequirement>
    <informationRequirement id="ir_d_Condition_status_Quality_status"><requiredDecision href="#d_Quality_status"/></informationRequirement>
    <decisionTable id="t_d_Condition_status" hitPolicy="FIRST">
      <input id="i_d_Condition_status_0" label="Condition"><inputExpression id="e_d_Condition_status_0" typeRef="string"><text>Condition</text></inputExpression></input>
      <input id="i_d_Condition_status_1" label="Applicability"><inputExpression id="e_d_Condition_status_1" typeRef="string"><text>Applicability</text></inputExpression></input>
