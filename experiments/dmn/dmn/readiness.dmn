      <input id="i_d_Condition_status_9" label="Approval on this version"><inputExpression id="e_d_Condition_status_9" typeRef="string"><text>Approval on this version</text></inputExpression></input>
      <input id="i_d_Condition_status_10" label="Source validity"><inputExpression id="e_d_Condition_status_10" typeRef="string"><text>Source validity</text></inputExpression></input>
      <output id="o_d_Condition_status" name="Condition status" typeRef="string"/>
