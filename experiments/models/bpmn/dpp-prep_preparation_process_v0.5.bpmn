<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_dpp_prep_v05" targetNamespace="http://example.org/dpp-prep">
<bpmn:collaboration id="Collab"><bpmn:participant id="Pool" name="Manufacturer: DPP information preparation (process model v0.5)" processRef="Proc"/>
<bpmn:textAnnotation id="A1"><bpmn:text>The AI may only propose. It cannot check, review, approve or release.</bpmn:text></bpmn:textAnnotation><bpmn:association id="As_A1" sourceRef="T_Propose" targetRef="A1"/>
<bpmn:textAnnotation id="A2"><bpmn:text>Correction clears earlier checks, review and approval; the record gets a new version.</bpmn:text></bpmn:textAnnotation><bpmn:association id="As_A2" sourceRef="T_Correct" targetRef="A2"/>
<bpmn:textAnnotation id="A3"><bpmn:text>Preconditions: all checks passed on this exact version; reviewer inspected evidence; approver is a different person.</bpmn:text></bpmn:textAnnotation><bpmn:association id="As_A3" sourceRef="T_Approve" targetRef="A3"/>
<bpmn:textAnnotation id="A4"><bpmn:text>An element may be held in a structured record, in documents, or in both. dpp-prep v0.3 takes one path per element.</bpmn:text></bpmn:textAnnotation><bpmn:association id="As_A4" sourceRef="G_Split" targetRef="A4"/>
<bpmn:textAnnotation id="A5"><bpmn:text>Every task writes an event to the diary (only some links shown); entries are appended, never edited.</bpmn:text></bpmn:textAnnotation><bpmn:association id="As_A5" sourceRef="DS_Diary" targetRef="A5"/>
<bpmn:textAnnotation id="A6"><bpmn:text>No default values: an element without a supported value stays unresolved.</bpmn:text></bpmn:textAnnotation><bpmn:association id="As_A6" sourceRef="E_Unresolved" targetRef="A6"/><bpmn:group id="G1" categoryValueRef="CV1"/><bpmn:group id="G2" categoryValueRef="CV2"/><bpmn:group id="G3" categoryValueRef="CV3"/><bpmn:textAnnotation id="A7"><bpmn:text>Dash-dot groups: activities in the process model that are not implemented in dpp-prep v0.3.2 (source selection, periodic validity trigger, obtaining missing information).</bpmn:text></bpmn:textAnnotation></bpmn:collaboration>
<bpmn:category id="Cat1"><bpmn:categoryValue id="CV1" value=""/><bpmn:categoryValue id="CV2" value=""/><bpmn:categoryValue id="CV3" value=""/></bpmn:category>
<bpmn:process id="Proc" isExecutable="false"><bpmn:laneSet id="LS">
<bpmn:lane id="Lane_OWN" name="Information owner"><bpmn:flowNodeRef>Start</bpmn:flowNodeRef><bpmn:flowNodeRef>T_Select</bpmn:flowNodeRef><bpmn:flowNodeRef>T_Obtain</bpmn:flowNodeRef><bpmn:flowNodeRef>G_Obtained</bpmn:flowNodeRef><bpmn:flowNodeRef>E_Unresolved</bpmn:flowNodeRef></bpmn:lane>
<bpmn:lane id="Lane_AI" name="AI (language model)"><bpmn:flowNodeRef>T_Propose</bpmn:flowNodeRef></bpmn:lane>
<bpmn:lane id="Lane_SW" name="Software (preparation engine)"><bpmn:flowNodeRef>G_Split</bpmn:flowNodeRef><bpmn:flowNodeRef>T_Import</bpmn:flowNodeRef><bpmn:flowNodeRef>G_Join</bpmn:flowNodeRef><bpmn:flowNodeRef>T_Verify</bpmn:flowNodeRef><bpmn:flowNodeRef>G_Supported</bpmn:flowNodeRef><bpmn:flowNodeRef>T_Checks</bpmn:flowNodeRef><bpmn:flowNodeRef>G_Guard</bpmn:flowNodeRef><bpmn:flowNodeRef>E_Refused</bpmn:flowNodeRef><bpmn:flowNodeRef>T_Release</bpmn:flowNodeRef><bpmn:flowNodeRef>E_Released</bpmn:flowNodeRef></bpmn:lane>
<bpmn:lane id="Lane_REV" name="Reviewer (e.g. quality engineer)"><bpmn:flowNodeRef>T_Review</bpmn:flowNodeRef><bpmn:flowNodeRef>G_Decision</bpmn:flowNodeRef><bpmn:flowNodeRef>E_Rejected</bpmn:flowNodeRef><bpmn:flowNodeRef>T_Correct</bpmn:flowNodeRef></bpmn:lane>
<bpmn:lane id="Lane_APP" name="Approver (responsible person)"><bpmn:flowNodeRef>T_Approve</bpmn:flowNodeRef></bpmn:lane>
</bpmn:laneSet>
<bpmn:dataStoreReference id="DS_Diary" name="Diary (who, role, what, when, record version)"/>
<bpmn:dataStoreReference id="DS_Sources" name="Source documents and ERP record"/>
<bpmn:dataStoreReference id="DS_Profile" name="Element profile"/>
<bpmn:dataStoreReference id="DS_Handover" name="Handover package (JSON)"/>
<bpmn:dataObjectReference id="DO_Record" name="Record (versioned)" dataObjectRef="DO_Rec"/>
<bpmn:dataObject id="DO_Rec"/>
<bpmn:startEvent id="Start" name="Requirement or new source received"><bpmn:outgoing>F1</bpmn:outgoing><bpmn:messageEventDefinition id="MED1"/></bpmn:startEvent>
<bpmn:startEvent id="Start_Timer" name="Periodic check of source validity"><bpmn:outgoing>F24</bpmn:outgoing><bpmn:timerEventDefinition id="TED1"/></bpmn:startEvent>
<bpmn:userTask id="T_Select" name="Select source documents and records"><bpmn:incoming>F1</bpmn:incoming><bpmn:incoming>F12</bpmn:incoming><bpmn:incoming>F24</bpmn:incoming><bpmn:outgoing>F2</bpmn:outgoing><bpmn:dataInputAssociation id="DI1"><bpmn:sourceRef>DS_Sources</bpmn:sourceRef></bpmn:dataInputAssociation></bpmn:userTask>
<bpmn:inclusiveGateway id="G_Split" name="Which sources hold the element?"><bpmn:incoming>F2</bpmn:incoming><bpmn:outgoing>F3</bpmn:outgoing><bpmn:outgoing>F4</bpmn:outgoing></bpmn:inclusiveGateway>
<bpmn:serviceTask id="T_Propose" name="Propose value with quote from document"><bpmn:incoming>F3</bpmn:incoming><bpmn:outgoing>F5</bpmn:outgoing></bpmn:serviceTask>
<bpmn:serviceTask id="T_Import" name="Import value from structured record"><bpmn:incoming>F4</bpmn:incoming><bpmn:outgoing>F6</bpmn:outgoing></bpmn:serviceTask>
<bpmn:inclusiveGateway id="G_Join"><bpmn:incoming>F5</bpmn:incoming><bpmn:incoming>F6</bpmn:incoming><bpmn:outgoing>F7</bpmn:outgoing></bpmn:inclusiveGateway>
<bpmn:serviceTask id="T_Verify" name="Verify evidence: quote found and supports value"><bpmn:incoming>F7</bpmn:incoming><bpmn:incoming>F18</bpmn:incoming><bpmn:outgoing>F8</bpmn:outgoing><bpmn:dataOutputAssociation id="DO4"><bpmn:targetRef>DS_Diary</bpmn:targetRef></bpmn:dataOutputAssociation></bpmn:serviceTask>
<bpmn:exclusiveGateway id="G_Supported" name="Supported value remains?"><bpmn:incoming>F8</bpmn:incoming><bpmn:outgoing>F9</bpmn:outgoing><bpmn:outgoing>F10</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:serviceTask id="T_Checks" name="Run rule checks (identity, unit, scope, conflict, composition)"><bpmn:incoming>F9</bpmn:incoming><bpmn:outgoing>F14</bpmn:outgoing><bpmn:dataInputAssociation id="DI2"><bpmn:sourceRef>DS_Profile</bpmn:sourceRef></bpmn:dataInputAssociation></bpmn:serviceTask>
<bpmn:userTask id="T_Obtain" name="Obtain or create the missing information at its source"><bpmn:incoming>F10</bpmn:incoming><bpmn:outgoing>F11</bpmn:outgoing></bpmn:userTask>
<bpmn:exclusiveGateway id="G_Obtained" name="Obtained?"><bpmn:incoming>F11</bpmn:incoming><bpmn:outgoing>F12</bpmn:outgoing><bpmn:outgoing>F13</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:endEvent id="E_Unresolved" name="Unresolved (recorded in diary)"><bpmn:incoming>F13</bpmn:incoming></bpmn:endEvent>
<bpmn:userTask id="T_Review" name="Inspect evidence and decide"><bpmn:incoming>F14</bpmn:incoming><bpmn:outgoing>F15</bpmn:outgoing></bpmn:userTask>
<bpmn:exclusiveGateway id="G_Decision" name="Decision?"><bpmn:incoming>F15</bpmn:incoming><bpmn:outgoing>F16</bpmn:outgoing><bpmn:outgoing>F17</bpmn:outgoing><bpmn:outgoing>F19</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:endEvent id="E_Rejected" name="Not released"><bpmn:incoming>F16</bpmn:incoming></bpmn:endEvent>
<bpmn:userTask id="T_Correct" name="Correct value with source evidence"><bpmn:incoming>F17</bpmn:incoming><bpmn:outgoing>F18</bpmn:outgoing></bpmn:userTask>
<bpmn:userTask id="T_Approve" name="Approve exact record version"><bpmn:incoming>F19</bpmn:incoming><bpmn:outgoing>F20</bpmn:outgoing><bpmn:dataOutputAssociation id="DO6"><bpmn:targetRef>DS_Diary</bpmn:targetRef></bpmn:dataOutputAssociation><bpmn:dataInputAssociation id="DI8"><bpmn:sourceRef>DO_Record</bpmn:sourceRef></bpmn:dataInputAssociation></bpmn:userTask>
<bpmn:exclusiveGateway id="G_Guard" name="Approval accepted? (all checks passed on this exact version; approver differs from reviewer)"><bpmn:incoming>F20</bpmn:incoming><bpmn:outgoing>F21</bpmn:outgoing><bpmn:outgoing>F22</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:endEvent id="E_Refused" name="Action refused (refusal logged)"><bpmn:incoming>F22</bpmn:incoming></bpmn:endEvent>
<bpmn:serviceTask id="T_Release" name="Validate package against schema and release"><bpmn:incoming>F21</bpmn:incoming><bpmn:outgoing>F23</bpmn:outgoing><bpmn:dataOutputAssociation id="DO3"><bpmn:targetRef>DS_Handover</bpmn:targetRef></bpmn:dataOutputAssociation></bpmn:serviceTask>
<bpmn:endEvent id="E_Released" name="Released DPP-ready handover package"><bpmn:incoming>F23</bpmn:incoming></bpmn:endEvent>
<bpmn:sequenceFlow id="F24" sourceRef="Start_Timer" targetRef="T_Select"/>
<bpmn:sequenceFlow id="F1" sourceRef="Start" targetRef="T_Select"/>
<bpmn:sequenceFlow id="F2" sourceRef="T_Select" targetRef="G_Split"/>
<bpmn:sequenceFlow id="F3" name="document" sourceRef="G_Split" targetRef="T_Propose"/>
<bpmn:sequenceFlow id="F4" name="structured record" sourceRef="G_Split" targetRef="T_Import"/>
<bpmn:sequenceFlow id="F5" sourceRef="T_Propose" targetRef="G_Join"/>
<bpmn:sequenceFlow id="F6" sourceRef="T_Import" targetRef="G_Join"/>
<bpmn:sequenceFlow id="F7" sourceRef="G_Join" targetRef="T_Verify"/>
<bpmn:sequenceFlow id="F8" sourceRef="T_Verify" targetRef="G_Supported"/>
<bpmn:sequenceFlow id="F9" name="yes" sourceRef="G_Supported" targetRef="T_Checks"/>
<bpmn:sequenceFlow id="F10" name="no" sourceRef="G_Supported" targetRef="T_Obtain"/>
<bpmn:sequenceFlow id="F11" sourceRef="T_Obtain" targetRef="G_Obtained"/>
<bpmn:sequenceFlow id="F12" name="yes: enters as a new source" sourceRef="G_Obtained" targetRef="T_Select"/>
<bpmn:sequenceFlow id="F13" name="no" sourceRef="G_Obtained" targetRef="E_Unresolved"/>
<bpmn:sequenceFlow id="F14" name="checked or flagged" sourceRef="T_Checks" targetRef="T_Review"/>
<bpmn:sequenceFlow id="F15" sourceRef="T_Review" targetRef="G_Decision"/>
<bpmn:sequenceFlow id="F16" name="reject" sourceRef="G_Decision" targetRef="E_Rejected"/>
<bpmn:sequenceFlow id="F17" name="correct" sourceRef="G_Decision" targetRef="T_Correct"/>
<bpmn:sequenceFlow id="F18" name="re-verify" sourceRef="T_Correct" targetRef="T_Verify"/>
<bpmn:sequenceFlow id="F19" name="accept (chosen value must pass all checks; reason required if sources conflict)" sourceRef="G_Decision" targetRef="T_Approve"/>
<bpmn:sequenceFlow id="F20" sourceRef="T_Approve" targetRef="G_Guard"/>
<bpmn:sequenceFlow id="F21" name="yes" sourceRef="G_Guard" targetRef="T_Release"/>
<bpmn:sequenceFlow id="F22" name="no" sourceRef="G_Guard" targetRef="E_Refused"/>
<bpmn:sequenceFlow id="F23" sourceRef="T_Release" targetRef="E_Released"/>
</bpmn:process>
