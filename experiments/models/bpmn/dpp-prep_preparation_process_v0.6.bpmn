<bpmn:lane id="b_L_REV" name="Reviewer"><bpmn:flowNodeRef>b_T_DecideTech</bpmn:flowNodeRef><bpmn:flowNodeRef>b_G_TechDec</bpmn:flowNodeRef><bpmn:flowNodeRef>b_E_UnresTech</bpmn:flowNodeRef><bpmn:flowNodeRef>b_T_Correct</bpmn:flowNodeRef><bpmn:flowNodeRef>b_T_Review</bpmn:flowNodeRef><bpmn:flowNodeRef>b_G_Decision</bpmn:flowNodeRef><bpmn:flowNodeRef>b_E_Rejected</bpmn:flowNodeRef></bpmn:lane>
