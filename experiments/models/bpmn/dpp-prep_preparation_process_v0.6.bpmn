<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Defs_dpp_prep_v06" targetNamespace="http://example.org/dpp-prep">
<bpmn:error id="Err_Tech" name="Technical failure" errorCode="TECH"/>

<bpmn:collaboration id="a_Collab_Proc_Product"><bpmn:participant id="a_Pool_Proc_Product" name="Manufacturer: DPP information preparation, product level (BPMN v0.6, refined design)" processRef="Proc_Product"/>
<bpmn:participant id="a_P_Ext" name="External parties (customer, supplier, regulation)"/>
<bpmn:participant id="a_P_DPP" name="Receiving DPP system or customer"/>
<bpmn:messageFlow id="a_MF1" name="requirement, new or updated source" sourceRef="a_P_Ext" targetRef="a_Start_Msg"/>
<bpmn:messageFlow id="a_MF2" name="handover package (JSON)" sourceRef="a_E_Released" targetRef="a_P_DPP"/>
<bpmn:textAnnotation id="a_A1"><bpmn:text>One instance per required element. Each ends normally (approved, rejected, unresolved or unresolved-technical); all outcomes are collected before assembly.</bpmn:text></bpmn:textAnnotation>
<bpmn:association id="a_As_A1" sourceRef="a_CA_Prepare" targetRef="a_A1"/>
<bpmn:textAnnotation id="a_A2"><bpmn:text>Completeness: are all required elements approved and included? Readiness: are all applicable conditions met? Reported separately; a complete package can be not ready.</bpmn:text></bpmn:textAnnotation>
<bpmn:association id="a_As_A2" sourceRef="a_B15c" targetRef="a_A2"/>
<bpmn:textAnnotation id="a_A3"><bpmn:text>The release decision is separate from record approval; every release or hold is logged with actor, package version, time and reason.</bpmn:text></bpmn:textAnnotation>
<bpmn:association id="a_As_A3" sourceRef="a_B16" targetRef="a_A3"/>
<bpmn:textAnnotation id="a_A4"><bpmn:text>Dash-dot groups: refined design v0.6, not implemented in dpp-prep v0.3.2. The demonstrator assembles, validates and releases one package per product when the approver triggers release.</bpmn:text></bpmn:textAnnotation>
<bpmn:group id="a_GrA"/>
<bpmn:group id="a_GrB"/>
<bpmn:group id="a_GrC"/>
<bpmn:group id="a_GrD"/>
<bpmn:group id="a_GrE"/>
</bpmn:collaboration>
<bpmn:process id="Proc_Product" isExecutable="false">
<bpmn:laneSet id="a_LS_Proc_Product">
<bpmn:lane id="a_L_OWN" name="Information owner"><bpmn:flowNodeRef>a_Start_Msg</bpmn:flowNodeRef><bpmn:flowNodeRef>a_Start_Timer</bpmn:flowNodeRef><bpmn:flowNodeRef>a_B02</bpmn:flowNodeRef></bpmn:lane>
<bpmn:lane id="a_L_SW" name="Software controls"><bpmn:flowNodeRef>a_G_Known</bpmn:flowNodeRef><bpmn:flowNodeRef>a_CA_Prepare</bpmn:flowNodeRef><bpmn:flowNodeRef>a_B15</bpmn:flowNodeRef><bpmn:flowNodeRef>a_B15b</bpmn:flowNodeRef><bpmn:flowNodeRef>a_G_Schema</bpmn:flowNodeRef><bpmn:flowNodeRef>a_E_HeldSchema</bpmn:flowNodeRef><bpmn:flowNodeRef>a_B15c</bpmn:flowNodeRef><bpmn:flowNodeRef>a_B17</bpmn:flowNodeRef><bpmn:flowNodeRef>a_E_Released</bpmn:flowNodeRef></bpmn:lane>
<bpmn:lane id="a_L_APP" name="Approver"><bpmn:flowNodeRef>a_B16</bpmn:flowNodeRef><bpmn:flowNodeRef>a_G_Release</bpmn:flowNodeRef><bpmn:flowNodeRef>a_E_Held</bpmn:flowNodeRef></bpmn:lane>
</bpmn:laneSet>
<bpmn:dataObject id="a_Obj_DO_Outcomes"/><bpmn:dataObjectReference id="a_DO_Outcomes" name="Element outcomes (collection)" dataObjectRef="a_Obj_DO_Outcomes"/>
<bpmn:dataStoreReference id="a_DS_Handover" name="Handover package"/>
<bpmn:startEvent id="a_Start_Msg" name="Requirement or new source received"><bpmn:outgoing>a_F1</bpmn:outgoing><bpmn:messageEventDefinition id="a_MED_9a"/></bpmn:startEvent>
<bpmn:startEvent id="a_Start_Timer" name="Source validity due"><bpmn:outgoing>a_F2</bpmn:outgoing><bpmn:timerEventDefinition id="a_TED_9a"/></bpmn:startEvent>
<bpmn:userTask id="a_B02" name="Identify requirement, product and affected elements"><bpmn:incoming>a_F1</bpmn:incoming><bpmn:incoming>a_F2</bpmn:incoming><bpmn:outgoing>a_F3</bpmn:outgoing></bpmn:userTask>
<bpmn:exclusiveGateway id="a_G_Known" name="Required elements known?"><bpmn:incoming>a_F3</bpmn:incoming><bpmn:outgoing>a_F4</bpmn:outgoing><bpmn:outgoing>a_F5</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:callActivity id="a_CA_Prepare" name="Prepare information element (Figure 9b)" calledElement="Proc_Element"><bpmn:incoming>a_F4</bpmn:incoming><bpmn:outgoing>a_F6</bpmn:outgoing><bpmn:ioSpecification id="a_IO_CA"><bpmn:dataInput id="a_DIn_Elements" name="Required elements (element ID + requirement version)" isCollection="true"/><bpmn:dataOutput id="a_DOut_Outcomes" name="Element outcomes (element ID, outcome, approved record version, reason)" isCollection="true"/><bpmn:inputSet id="a_IS_CA"><bpmn:dataInputRefs>a_DIn_Elements</bpmn:dataInputRefs></bpmn:inputSet><bpmn:outputSet id="a_OS_CA"><bpmn:dataOutputRefs>a_DOut_Outcomes</bpmn:dataOutputRefs></bpmn:outputSet></bpmn:ioSpecification><bpmn:dataOutputAssociation id="a_DOa1"><bpmn:targetRef>a_DO_Outcomes</bpmn:targetRef></bpmn:dataOutputAssociation><bpmn:multiInstanceLoopCharacteristics id="a_MI_9a" isSequential="false"><bpmn:loopDataInputRef>a_DIn_Elements</bpmn:loopDataInputRef><bpmn:loopDataOutputRef>a_DOut_Outcomes</bpmn:loopDataOutputRef><bpmn:inputDataItem id="a_Item_Element" name="one required element + requirement context"/><bpmn:outputDataItem id="a_Item_Outcome" name="element outcome: approved | rejected | unresolved | unresolved-technical, record version, reason"/></bpmn:multiInstanceLoopCharacteristics></bpmn:callActivity>
<bpmn:serviceTask id="a_B15" name="Assemble package"><bpmn:incoming>a_F5</bpmn:incoming><bpmn:incoming>a_F6</bpmn:incoming><bpmn:outgoing>a_F7</bpmn:outgoing><bpmn:dataInputAssociation id="a_DIa1"><bpmn:sourceRef>a_DO_Outcomes</bpmn:sourceRef></bpmn:dataInputAssociation></bpmn:serviceTask>
<bpmn:serviceTask id="a_B15b" name="Validate package against schema"><bpmn:incoming>a_F7</bpmn:incoming><bpmn:outgoing>a_F8</bpmn:outgoing></bpmn:serviceTask>
<bpmn:exclusiveGateway id="a_G_Schema" name="Schema valid?"><bpmn:incoming>a_F8</bpmn:incoming><bpmn:outgoing>a_F9</bpmn:outgoing><bpmn:outgoing>a_F10</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:endEvent id="a_E_HeldSchema" name="Release held (schema invalid)"><bpmn:incoming>a_F10</bpmn:incoming></bpmn:endEvent>
<bpmn:serviceTask id="a_B15c" name="Assess completeness and readiness qualification"><bpmn:incoming>a_F9</bpmn:incoming><bpmn:outgoing>a_F11</bpmn:outgoing></bpmn:serviceTask>
<bpmn:userTask id="a_B16" name="Decide release"><bpmn:incoming>a_F11</bpmn:incoming><bpmn:outgoing>a_F12</bpmn:outgoing></bpmn:userTask>
<bpmn:exclusiveGateway id="a_G_Release" name="Release or hold?"><bpmn:incoming>a_F12</bpmn:incoming><bpmn:outgoing>a_F13</bpmn:outgoing><bpmn:outgoing>a_F14</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:serviceTask id="a_B17" name="Execute release and record outcome"><bpmn:incoming>a_F13</bpmn:incoming><bpmn:outgoing>a_F15</bpmn:outgoing><bpmn:dataOutputAssociation id="a_DOa2"><bpmn:targetRef>a_DS_Handover</bpmn:targetRef></bpmn:dataOutputAssociation></bpmn:serviceTask>
<bpmn:endEvent id="a_E_Released" name="Handover package released"><bpmn:incoming>a_F15</bpmn:incoming><bpmn:messageEventDefinition id="a_MED_9a2"/></bpmn:endEvent>
<bpmn:endEvent id="a_E_Held" name="Release held (reason recorded)"><bpmn:incoming>a_F14</bpmn:incoming></bpmn:endEvent>
<bpmn:sequenceFlow id="a_F1" sourceRef="a_Start_Msg" targetRef="a_B02"/>
