<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_dpp_prep" targetNamespace="https://github.com/biswaskc57/dpp-prep" exporter="dpp-prep make_bpmn.py" exporterVersion="1.0">
  <bpmn:collaboration id="Collab">
    <bpmn:participant id="Pool" name="Manufacturer: DPP information preparation (dpp-prep v0.3)" processRef="Process_Prep" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Prep" isExecutable="false">
    <bpmn:laneSet id="LaneSet">
      <bpmn:lane id="Lane_AI" name="AI (language model)">
        <bpmn:flowNodeRef>T_Propose</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_SW" name="Software (preparation engine)">
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Load</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_Route</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Import</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Verify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_Supported</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_Unresolved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Checks</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_Guard</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_Refused</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Release</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_Released</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_REV" name="Reviewer (e.g. quality engineer)">
        <bpmn:flowNodeRef>T_Review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_Decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Correct</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_Rejected</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_APP" name="Approver (responsible person)">
        <bpmn:flowNodeRef>T_Approve</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:dataStoreReference id="DS_Diary" name="Diary: every proposal, check, decision and refusal is appended (never edited)" />
    <bpmn:startEvent id="Start" name="Information need identified (product profile loaded)">
      <bpmn:outgoing>F1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="T_Load" name="Load source documents and records">
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G_Route" name="Structured record or document?">
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:outgoing>F3</bpmn:outgoing>
      <bpmn:outgoing>F4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_Propose" name="Propose value with quote from document">
      <bpmn:incoming>F3</bpmn:incoming>
      <bpmn:outgoing>F5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_Import" name="Import value from structured record">
      <bpmn:incoming>F4</bpmn:incoming>
      <bpmn:outgoing>F6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="T_Verify" name="Verify evidence: quote found and supports value">
      <bpmn:incoming>F5</bpmn:incoming>
      <bpmn:incoming>F6</bpmn:incoming>
      <bpmn:incoming>F13</bpmn:incoming>
      <bpmn:outgoing>F7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G_Supported" name="Evidence supports value?">
      <bpmn:incoming>F7</bpmn:incoming>
      <bpmn:outgoing>F8</bpmn:outgoing>
      <bpmn:outgoing>F9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="E_Unresolved" name="Unresolved (proposal kept in diary)">
      <bpmn:incoming>F8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="T_Checks" name="Run rule checks (unit, scope, identity, conflict)">
      <bpmn:incoming>F9</bpmn:incoming>
      <bpmn:outgoing>F10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="T_Review" name="Inspect evidence and decide">
      <bpmn:incoming>F10</bpmn:incoming>
      <bpmn:outgoing>F11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="G_Decision" name="Decision?">
      <bpmn:incoming>F11</bpmn:incoming>
      <bpmn:outgoing>F12</bpmn:outgoing>
      <bpmn:outgoing>F14</bpmn:outgoing>
      <bpmn:outgoing>F15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T_Correct" name="Correct value with source evidence">
      <bpmn:incoming>F12</bpmn:incoming>
      <bpmn:outgoing>F13</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="E_Rejected" name="Not released">
      <bpmn:incoming>F14</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="T_Approve" name="Approve exact record version">
      <bpmn:incoming>F15</bpmn:incoming>
      <bpmn:outgoing>F16</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="G_Guard" name="Approval preconditions met?">
      <bpmn:incoming>F16</bpmn:incoming>
      <bpmn:outgoing>F17</bpmn:outgoing>
      <bpmn:outgoing>F18</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="E_Refused" name="Action refused (refusal logged)">
      <bpmn:incoming>F17</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="T_Release" name="Validate package against schema and release">
      <bpmn:incoming>F18</bpmn:incoming>
      <bpmn:outgoing>F19</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="E_Released" name="Released DPP-ready handover package">
      <bpmn:incoming>F19</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F1" sourceRef="Start" targetRef="T_Load" />
    <bpmn:sequenceFlow id="F2" sourceRef="T_Load" targetRef="G_Route" />
    <bpmn:sequenceFlow id="F3" name="document" sourceRef="G_Route" targetRef="T_Propose" />
    <bpmn:sequenceFlow id="F4" name="structured record" sourceRef="G_Route" targetRef="T_Import" />
    <bpmn:sequenceFlow id="F5" sourceRef="T_Propose" targetRef="T_Verify" />
    <bpmn:sequenceFlow id="F6" sourceRef="T_Import" targetRef="T_Verify" />
    <bpmn:sequenceFlow id="F7" sourceRef="T_Verify" targetRef="G_Supported" />
    <bpmn:sequenceFlow id="F8" name="no" sourceRef="G_Supported" targetRef="E_Unresolved" />
    <bpmn:sequenceFlow id="F9" name="yes" sourceRef="G_Supported" targetRef="T_Checks" />
    <bpmn:sequenceFlow id="F10" name="checked or flagged" sourceRef="T_Checks" targetRef="T_Review" />
    <bpmn:sequenceFlow id="F11" sourceRef="T_Review" targetRef="G_Decision" />
    <bpmn:sequenceFlow id="F12" name="correct" sourceRef="G_Decision" targetRef="T_Correct" />
    <bpmn:sequenceFlow id="F13" name="re-verify" sourceRef="T_Correct" targetRef="T_Verify" />
    <bpmn:sequenceFlow id="F14" name="reject" sourceRef="G_Decision" targetRef="E_Rejected" />
    <bpmn:sequenceFlow id="F15" name="accept (reason required if sources conflict)" sourceRef="G_Decision" targetRef="T_Approve" />
    <bpmn:sequenceFlow id="F16" sourceRef="T_Approve" targetRef="G_Guard" />
    <bpmn:sequenceFlow id="F17" name="no" sourceRef="G_Guard" targetRef="E_Refused" />
    <bpmn:sequenceFlow id="F18" name="yes" sourceRef="G_Guard" targetRef="T_Release" />
    <bpmn:sequenceFlow id="F19" sourceRef="T_Release" targetRef="E_Released" />
    <bpmn:textAnnotation id="A1"><bpmn:text>The AI may only propose. It cannot check, review, approve or release.</bpmn:text></bpmn:textAnnotation>
    <bpmn:textAnnotation id="A2"><bpmn:text>Correction clears earlier checks, review and approval; the record gets a new version.</bpmn:text></bpmn:textAnnotation>
    <bpmn:textAnnotation id="A3"><bpmn:text>Preconditions: all checks passed on this exact version; reviewer inspected evidence; approver is a different person.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="As_A1" sourceRef="T_Propose" targetRef="A1" />
    <bpmn:association id="As_A2" sourceRef="T_Correct" targetRef="A2" />
    <bpmn:association id="As_A3" sourceRef="T_Approve" targetRef="A3" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram">
    <bpmndi:BPMNPlane id="Plane" bpmnElement="Collab">
      <bpmndi:BPMNShape id="Pool_di" bpmnElement="Pool" isHorizontal="true"><dc:Bounds x="100" y="80" width="1900" height="700" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_AI_di" bpmnElement="Lane_AI" isHorizontal="true"><dc:Bounds x="130" y="80" width="1870" height="150" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_SW_di" bpmnElement="Lane_SW" isHorizontal="true"><dc:Bounds x="130" y="230" width="1870" height="200" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_REV_di" bpmnElement="Lane_REV" isHorizontal="true"><dc:Bounds x="130" y="430" width="1870" height="200" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_APP_di" bpmnElement="Lane_APP" isHorizontal="true"><dc:Bounds x="130" y="630" width="1870" height="150" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_di" bpmnElement="Start"><dc:Bounds x="172" y="287" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="140" y="327" width="110" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
