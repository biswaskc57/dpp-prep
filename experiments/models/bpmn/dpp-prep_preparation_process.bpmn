      <bpmndi:BPMNShape id="T_Verify_di" bpmnElement="T_Verify"><dc:Bounds x="700" y="270" width="120" height="70" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="G_Supported_di" bpmnElement="G_Supported" isMarkerVisible="true"><dc:Bounds x="860" y="280" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="830" y="240" width="110" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="E_Unresolved_di" bpmnElement="E_Unresolved"><dc:Bounds x="867" y="377" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="909" y="382" width="110" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_Checks_di" bpmnElement="T_Checks"><dc:Bounds x="970" y="270" width="120" height="70" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_Review_di" bpmnElement="T_Review"><dc:Bounds x="1150" y="540" width="120" height="70" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="G_Decision_di" bpmnElement="G_Decision" isMarkerVisible="true"><dc:Bounds x="1330" y="550" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="1262" y="610" width="60" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_Correct_di" bpmnElement="T_Correct"><dc:Bounds x="1150" y="440" width="120" height="70" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="E_Rejected_di" bpmnElement="E_Rejected"><dc:Bounds x="1420" y="557" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1462" y="562" width="80" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_Approve_di" bpmnElement="T_Approve"><dc:Bounds x="1295" y="670" width="120" height="70" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="G_Guard_di" bpmnElement="G_Guard" isMarkerVisible="true"><dc:Bounds x="1550" y="280" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="1520" y="240" width="110" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="E_Refused_di" bpmnElement="E_Refused"><dc:Bounds x="1557" y="377" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1599" y="382" width="110" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_Release_di" bpmnElement="T_Release"><dc:Bounds x="1650" y="270" width="120" height="70" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="E_Released_di" bpmnElement="E_Released"><dc:Bounds x="1830" y="287" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1795" y="327" width="110" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
