<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Defs_9a" targetNamespace="http://example.org/dpp-prep">
<bpmn:collaboration id="Collab_Proc_Product"><bpmn:participant id="Pool_Proc_Product" name="Manufacturer: DPP information preparation, product level (BPMN v0.6, refined design)" processRef="Proc_Product"/>
<bpmn:participant id="P_Ext" name="External parties (customer, supplier, regulation)"/>
<bpmn:participant id="P_DPP" name="Receiving DPP system or customer"/>
<bpmn:messageFlow id="MF1" name="requirement, new or updated source" sourceRef="P_Ext" targetRef="Start_Msg"/>
<bpmn:messageFlow id="MF2" name="handover package (JSON)" sourceRef="E_Released" targetRef="P_DPP"/>
<bpmn:textAnnotation id="A1"><bpmn:text>One instance per required element. Each ends normally (approved, rejected, unresolved or unresolved-technical); all outcomes are collected before assembly.</bpmn:text></bpmn:textAnnotation>
<bpmn:association id="As_A1" sourceRef="CA_Prepare" targetRef="A1"/>
<bpmn:textAnnotation id="A2"><bpmn:text>Completeness: are all required elements approved and included? Readiness: are all applicable conditions met? Reported separately; a complete package can be not ready.</bpmn:text></bpmn:textAnnotation>
<bpmn:association id="As_A2" sourceRef="B15c" targetRef="A2"/>
<bpmn:textAnnotation id="A3"><bpmn:text>The release decision is separate from record approval; every release or hold is logged with actor, package version, time and reason.</bpmn:text></bpmn:textAnnotation>
<bpmn:association id="As_A3" sourceRef="B16" targetRef="A3"/>
<bpmn:textAnnotation id="A4"><bpmn:text>Dash-dot groups: refined design v0.6, not implemented in dpp-prep v0.3.2. The demonstrator assembles, validates and releases one package per product when the approver triggers release.</bpmn:text></bpmn:textAnnotation>
<bpmn:group id="GrA"/>
<bpmn:group id="GrB"/>
<bpmn:group id="GrC"/>
<bpmn:group id="GrD"/>
<bpmn:group id="GrE"/>
</bpmn:collaboration>
<bpmn:process id="Proc_Product" isExecutable="false">
<bpmn:laneSet id="LS_Proc_Product">
<bpmn:lane id="L_OWN" name="Information owner"><bpmn:flowNodeRef>Start_Msg</bpmn:flowNodeRef><bpmn:flowNodeRef>Start_Timer</bpmn:flowNodeRef><bpmn:flowNodeRef>B02</bpmn:flowNodeRef></bpmn:lane>
<bpmn:lane id="L_SW" name="Software controls"><bpmn:flowNodeRef>G_Known</bpmn:flowNodeRef><bpmn:flowNodeRef>CA_Prepare</bpmn:flowNodeRef><bpmn:flowNodeRef>B15</bpmn:flowNodeRef><bpmn:flowNodeRef>B15b</bpmn:flowNodeRef><bpmn:flowNodeRef>G_Schema</bpmn:flowNodeRef><bpmn:flowNodeRef>E_HeldSchema</bpmn:flowNodeRef><bpmn:flowNodeRef>B15c</bpmn:flowNodeRef><bpmn:flowNodeRef>B17</bpmn:flowNodeRef><bpmn:flowNodeRef>E_Released</bpmn:flowNodeRef></bpmn:lane>
<bpmn:lane id="L_APP" name="Approver"><bpmn:flowNodeRef>B16</bpmn:flowNodeRef><bpmn:flowNodeRef>G_Release</bpmn:flowNodeRef><bpmn:flowNodeRef>E_Held</bpmn:flowNodeRef></bpmn:lane>
</bpmn:laneSet>
<bpmn:dataObject id="Obj_DO_Outcomes"/><bpmn:dataObjectReference id="DO_Outcomes" name="Element outcomes (collection)" dataObjectRef="Obj_DO_Outcomes"/>
<bpmn:dataStoreReference id="DS_Handover" name="Handover package"/>
<bpmn:startEvent id="Start_Msg" name="Requirement or new source received"><bpmn:outgoing>F1</bpmn:outgoing><bpmn:messageEventDefinition id="MED_9a"/></bpmn:startEvent>
<bpmn:startEvent id="Start_Timer" name="Source validity due"><bpmn:outgoing>F2</bpmn:outgoing><bpmn:timerEventDefinition id="TED_9a"/></bpmn:startEvent>
<bpmn:userTask id="B02" name="Identify requirement, product and affected elements"><bpmn:incoming>F1</bpmn:incoming><bpmn:incoming>F2</bpmn:incoming><bpmn:outgoing>F3</bpmn:outgoing></bpmn:userTask>
<bpmn:exclusiveGateway id="G_Known" name="Required elements known?"><bpmn:incoming>F3</bpmn:incoming><bpmn:outgoing>F4</bpmn:outgoing><bpmn:outgoing>F5</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:callActivity id="CA_Prepare" name="Prepare information element (Figure 9b)" calledElement="Proc_Element"><bpmn:incoming>F4</bpmn:incoming><bpmn:outgoing>F6</bpmn:outgoing><bpmn:ioSpecification id="IO_CA"><bpmn:dataInput id="DIn_Elements" name="Required elements (element ID + requirement version)" isCollection="true"/><bpmn:dataOutput id="DOut_Outcomes" name="Element outcomes (element ID, outcome, approved record version, reason)" isCollection="true"/><bpmn:inputSet id="IS_CA"><bpmn:dataInputRefs>DIn_Elements</bpmn:dataInputRefs></bpmn:inputSet><bpmn:outputSet id="OS_CA"><bpmn:dataOutputRefs>DOut_Outcomes</bpmn:dataOutputRefs></bpmn:outputSet></bpmn:ioSpecification><bpmn:dataOutputAssociation id="DOa1"><bpmn:targetRef>DO_Outcomes</bpmn:targetRef></bpmn:dataOutputAssociation><bpmn:multiInstanceLoopCharacteristics id="MI_9a" isSequential="false"><bpmn:loopDataInputRef>DIn_Elements</bpmn:loopDataInputRef><bpmn:loopDataOutputRef>DOut_Outcomes</bpmn:loopDataOutputRef><bpmn:inputDataItem id="Item_Element" name="one required element + requirement context"/><bpmn:outputDataItem id="Item_Outcome" name="element outcome: approved | rejected | unresolved | unresolved-technical, record version, reason"/></bpmn:multiInstanceLoopCharacteristics></bpmn:callActivity>
<bpmn:serviceTask id="B15" name="Assemble package"><bpmn:incoming>F5</bpmn:incoming><bpmn:incoming>F6</bpmn:incoming><bpmn:outgoing>F7</bpmn:outgoing><bpmn:dataInputAssociation id="DIa1"><bpmn:sourceRef>DO_Outcomes</bpmn:sourceRef></bpmn:dataInputAssociation></bpmn:serviceTask>
<bpmn:serviceTask id="B15b" name="Validate package against schema"><bpmn:incoming>F7</bpmn:incoming><bpmn:outgoing>F8</bpmn:outgoing></bpmn:serviceTask>
<bpmn:exclusiveGateway id="G_Schema" name="Schema valid?"><bpmn:incoming>F8</bpmn:incoming><bpmn:outgoing>F9</bpmn:outgoing><bpmn:outgoing>F10</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:endEvent id="E_HeldSchema" name="Release held (schema invalid)"><bpmn:incoming>F10</bpmn:incoming></bpmn:endEvent>
<bpmn:serviceTask id="B15c" name="Assess completeness and readiness qualification"><bpmn:incoming>F9</bpmn:incoming><bpmn:outgoing>F11</bpmn:outgoing></bpmn:serviceTask>
<bpmn:userTask id="B16" name="Decide release"><bpmn:incoming>F11</bpmn:incoming><bpmn:outgoing>F12</bpmn:outgoing></bpmn:userTask>
<bpmn:exclusiveGateway id="G_Release" name="Release or hold?"><bpmn:incoming>F12</bpmn:incoming><bpmn:outgoing>F13</bpmn:outgoing><bpmn:outgoing>F14</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:serviceTask id="B17" name="Execute release and record outcome"><bpmn:incoming>F13</bpmn:incoming><bpmn:outgoing>F15</bpmn:outgoing><bpmn:dataOutputAssociation id="DOa2"><bpmn:targetRef>DS_Handover</bpmn:targetRef></bpmn:dataOutputAssociation></bpmn:serviceTask>
<bpmn:endEvent id="E_Released" name="Handover package released"><bpmn:incoming>F15</bpmn:incoming><bpmn:messageEventDefinition id="MED_9a2"/></bpmn:endEvent>
<bpmn:endEvent id="E_Held" name="Release held (reason recorded)"><bpmn:incoming>F14</bpmn:incoming></bpmn:endEvent>
<bpmn:sequenceFlow id="F1" sourceRef="Start_Msg" targetRef="B02"/>
<bpmn:sequenceFlow id="F2" sourceRef="Start_Timer" targetRef="B02"/>
<bpmn:sequenceFlow id="F3" sourceRef="B02" targetRef="G_Known"/>
<bpmn:sequenceFlow id="F4" name="yes" sourceRef="G_Known" targetRef="CA_Prepare"/>
<bpmn:sequenceFlow id="F5" name="no (undetermined)" sourceRef="G_Known" targetRef="B15"/>
<bpmn:sequenceFlow id="F6" sourceRef="CA_Prepare" targetRef="B15"/>
<bpmn:sequenceFlow id="F7" sourceRef="B15" targetRef="B15b"/>
<bpmn:sequenceFlow id="F8" sourceRef="B15b" targetRef="G_Schema"/>
<bpmn:sequenceFlow id="F9" name="yes" sourceRef="G_Schema" targetRef="B15c"/>
<bpmn:sequenceFlow id="F10" name="no" sourceRef="G_Schema" targetRef="E_HeldSchema"/>
<bpmn:sequenceFlow id="F11" sourceRef="B15c" targetRef="B16"/>
<bpmn:sequenceFlow id="F12" sourceRef="B16" targetRef="G_Release"/>
<bpmn:sequenceFlow id="F13" name="release" sourceRef="G_Release" targetRef="B17"/>
<bpmn:sequenceFlow id="F14" name="hold" sourceRef="G_Release" targetRef="E_Held"/>
<bpmn:sequenceFlow id="F15" sourceRef="B17" targetRef="E_Released"/>
</bpmn:process>
