<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Defs_9b" targetNamespace="http://example.org/dpp-prep">
<bpmn:error id="Err_Tech" name="Technical failure" errorCode="TECH"/>
<bpmn:collaboration id="Collab_Proc_Element"><bpmn:participant id="Pool_Proc_Element" name="Prepare information element: element level (BPMN v0.6, refined design; runs once per required element)" processRef="Proc_Element"/>
<bpmn:textAnnotation id="N1"><bpmn:text>The AI may only propose. It cannot check, review, approve or release.</bpmn:text></bpmn:textAnnotation>
<bpmn:association id="As_N1" sourceRef="T_Propose" targetRef="N1"/>
<bpmn:textAnnotation id="N2"><bpmn:text>The reviewer sees the readiness assessments with their reasons. Record-side refusals return here; a new review re-runs the checks on the current version.</bpmn:text></bpmn:textAnnotation>
<bpmn:association id="As_N2" sourceRef="T_Review" targetRef="N2"/>
<bpmn:textAnnotation id="N3"><bpmn:text>A correction creates a new record version. Earlier checks, assessments, review and approval stay as history but are not effective for it.</bpmn:text></bpmn:textAnnotation>
<bpmn:association id="As_N3" sourceRef="T_Correct" targetRef="N3"/>
<bpmn:textAnnotation id="N4"><bpmn:text>Approval preconditions: all checks passed on this exact version; evidence inspected; approver differs from reviewer and is in scope.</bpmn:text></bpmn:textAnnotation>
<bpmn:association id="As_N4" sourceRef="T_Approve" targetRef="N4"/>
<bpmn:textAnnotation id="N5"><bpmn:text>A technical failure never sets Available = not met; it stays not yet assessed, with the reason recorded.</bpmn:text></bpmn:textAnnotation>
<bpmn:association id="As_N5" sourceRef="E_UnresTech" targetRef="N5"/>
<bpmn:textAnnotation id="N6"><bpmn:text>Dash-dot groups: refined design v0.6, not implemented in dpp-prep v0.3.2. Call activities: Figure 9c. Error boundary events: technical failure.</bpmn:text></bpmn:textAnnotation>
<bpmn:group id="Gr1"/>
<bpmn:group id="Gr2"/>
<bpmn:group id="Gr3"/>
<bpmn:group id="Gr4"/>
<bpmn:group id="Gr5"/>
</bpmn:collaboration>
<bpmn:process id="Proc_Element" isExecutable="false">
<bpmn:laneSet id="LS_Proc_Element">
<bpmn:lane id="L_OWN" name="Information owner"><bpmn:flowNodeRef>Start</bpmn:flowNodeRef><bpmn:flowNodeRef>T_Select</bpmn:flowNodeRef><bpmn:flowNodeRef>T_Obtain</bpmn:flowNodeRef><bpmn:flowNodeRef>G_Obtained</bpmn:flowNodeRef><bpmn:flowNodeRef>E_Unresolved</bpmn:flowNodeRef></bpmn:lane>
<bpmn:lane id="L_AI" name="AI component (proposes only)"><bpmn:flowNodeRef>T_Propose</bpmn:flowNodeRef><bpmn:flowNodeRef>BE_Propose</bpmn:flowNodeRef></bpmn:lane>
<bpmn:lane id="L_SW" name="Software controls"><bpmn:flowNodeRef>G_Split</bpmn:flowNodeRef><bpmn:flowNodeRef>T_Import</bpmn:flowNodeRef><bpmn:flowNodeRef>G_Join</bpmn:flowNodeRef><bpmn:flowNodeRef>T_Locate</bpmn:flowNodeRef><bpmn:flowNodeRef>G_Located</bpmn:flowNodeRef><bpmn:flowNodeRef>T_Checks</bpmn:flowNodeRef><bpmn:flowNodeRef>SP_Assess</bpmn:flowNodeRef><bpmn:flowNodeRef>T_TechFail</bpmn:flowNodeRef><bpmn:flowNodeRef>G_Retries</bpmn:flowNodeRef><bpmn:flowNodeRef>BE_Import</bpmn:flowNodeRef><bpmn:flowNodeRef>BE_Locate</bpmn:flowNodeRef><bpmn:flowNodeRef>BE_Checks</bpmn:flowNodeRef></bpmn:lane>
<bpmn:lane id="L_REV" name="Reviewer"><bpmn:flowNodeRef>T_DecideTech</bpmn:flowNodeRef><bpmn:flowNodeRef>G_TechDec</bpmn:flowNodeRef><bpmn:flowNodeRef>E_UnresTech</bpmn:flowNodeRef><bpmn:flowNodeRef>T_Correct</bpmn:flowNodeRef><bpmn:flowNodeRef>T_Review</bpmn:flowNodeRef><bpmn:flowNodeRef>G_Decision</bpmn:flowNodeRef><bpmn:flowNodeRef>E_Rejected</bpmn:flowNodeRef></bpmn:lane>
<bpmn:lane id="L_APP" name="Approver"><bpmn:flowNodeRef>T_Approve</bpmn:flowNodeRef><bpmn:flowNodeRef>G_Guard</bpmn:flowNodeRef><bpmn:flowNodeRef>E_Approved</bpmn:flowNodeRef><bpmn:flowNodeRef>G_RefType</bpmn:flowNodeRef><bpmn:flowNodeRef>E_NoApprover</bpmn:flowNodeRef></bpmn:lane>
</bpmn:laneSet>
<bpmn:dataStoreReference id="DS_Sources" name="Sources (documents, structured records)"/>
<bpmn:dataObject id="Obj_DO_Check"/><bpmn:dataObjectReference id="DO_Check" name="Check results" dataObjectRef="Obj_DO_Check"/>
<bpmn:dataObject id="Obj_DO_Assess"/><bpmn:dataObjectReference id="DO_Assess" name="Readiness assessments" dataObjectRef="Obj_DO_Assess"/>
<bpmn:startEvent id="Start" name="Element assigned"><bpmn:outgoing>F1</bpmn:outgoing></bpmn:startEvent>
<bpmn:userTask id="T_Select" name="Select source documents and records"><bpmn:incoming>F1</bpmn:incoming><bpmn:incoming>F26</bpmn:incoming><bpmn:outgoing>F2</bpmn:outgoing><bpmn:dataInputAssociation id="DIa1"><bpmn:sourceRef>DS_Sources</bpmn:sourceRef></bpmn:dataInputAssociation></bpmn:userTask>
<bpmn:userTask id="T_Obtain" name="Obtain missing information or access at its source"><bpmn:incoming>F17</bpmn:incoming><bpmn:outgoing>F25</bpmn:outgoing></bpmn:userTask>
<bpmn:exclusiveGateway id="G_Obtained" name="Obtained?"><bpmn:incoming>F25</bpmn:incoming><bpmn:outgoing>F26</bpmn:outgoing><bpmn:outgoing>F27</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:endEvent id="E_Unresolved" name="Element unresolved (reason a or b)"><bpmn:incoming>F27</bpmn:incoming></bpmn:endEvent>
<bpmn:serviceTask id="T_Propose" name="Propose value with supporting evidence"><bpmn:incoming>F3</bpmn:incoming><bpmn:outgoing>F5</bpmn:outgoing></bpmn:serviceTask>
<bpmn:inclusiveGateway id="G_Split" name="Which sources hold the element?"><bpmn:incoming>F2</bpmn:incoming><bpmn:incoming>F33</bpmn:incoming><bpmn:outgoing>F3</bpmn:outgoing><bpmn:outgoing>F4</bpmn:outgoing></bpmn:inclusiveGateway>
<bpmn:serviceTask id="T_Import" name="Import value from structured record"><bpmn:incoming>F4</bpmn:incoming><bpmn:outgoing>F6</bpmn:outgoing></bpmn:serviceTask>
<bpmn:inclusiveGateway id="G_Join"><bpmn:incoming>F5</bpmn:incoming><bpmn:incoming>F6</bpmn:incoming><bpmn:outgoing>F7</bpmn:outgoing></bpmn:inclusiveGateway>
<bpmn:serviceTask id="T_Locate" name="Locate evidence"><bpmn:incoming>F7</bpmn:incoming><bpmn:incoming>F18</bpmn:incoming><bpmn:outgoing>F8</bpmn:outgoing></bpmn:serviceTask>
<bpmn:exclusiveGateway id="G_Located" name="Supported proposal left?"><bpmn:incoming>F8</bpmn:incoming><bpmn:outgoing>F9</bpmn:outgoing><bpmn:outgoing>F10</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:serviceTask id="T_Checks" name="Run rule checks (support, value type, identity, unit, scope, composition, conflict)"><bpmn:incoming>F9</bpmn:incoming><bpmn:outgoing>F11</bpmn:outgoing><bpmn:dataOutputAssociation id="DOa1"><bpmn:targetRef>DO_Check</bpmn:targetRef></bpmn:dataOutputAssociation></bpmn:serviceTask>
<bpmn:callActivity id="SP_Assess" name="Assess readiness and allocate response (Fig. 9c)" calledElement="Proc_Assess"><bpmn:incoming>F10</bpmn:incoming><bpmn:incoming>F11</bpmn:incoming><bpmn:outgoing>F12</bpmn:outgoing><bpmn:dataOutputAssociation id="DOa2"><bpmn:targetRef>DO_Assess</bpmn:targetRef></bpmn:dataOutputAssociation></bpmn:callActivity>
<bpmn:serviceTask id="T_TechFail" name="Handle technical failure (bounded retry)"><bpmn:incoming>F28</bpmn:incoming><bpmn:incoming>F29</bpmn:incoming><bpmn:incoming>F30</bpmn:incoming><bpmn:incoming>F31</bpmn:incoming><bpmn:incoming>F36</bpmn:incoming><bpmn:outgoing>F32</bpmn:outgoing></bpmn:serviceTask>
<bpmn:exclusiveGateway id="G_Retries" name="Retry left?"><bpmn:incoming>F32</bpmn:incoming><bpmn:outgoing>F33</bpmn:outgoing><bpmn:outgoing>F34</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:userTask id="T_DecideTech" name="Decide on technical failure"><bpmn:incoming>F34</bpmn:incoming><bpmn:outgoing>F35</bpmn:outgoing></bpmn:userTask>
<bpmn:exclusiveGateway id="G_TechDec"><bpmn:incoming>F35</bpmn:incoming><bpmn:outgoing>F36</bpmn:outgoing><bpmn:outgoing>F37</bpmn:outgoing><bpmn:outgoing>F38</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:endEvent id="E_UnresTech" name="Element unresolved-technical"><bpmn:incoming>F38</bpmn:incoming></bpmn:endEvent>
<bpmn:userTask id="T_Correct" name="Correct value with source evidence"><bpmn:incoming>F16</bpmn:incoming><bpmn:incoming>F37</bpmn:incoming><bpmn:outgoing>F18</bpmn:outgoing></bpmn:userTask>
<bpmn:userTask id="T_Review" name="Review evidence and readiness assessments; decide"><bpmn:incoming>F12</bpmn:incoming><bpmn:incoming>F22</bpmn:incoming><bpmn:outgoing>F13</bpmn:outgoing></bpmn:userTask>
<bpmn:exclusiveGateway id="G_Decision" name="Decision?"><bpmn:incoming>F13</bpmn:incoming><bpmn:outgoing>F14</bpmn:outgoing><bpmn:outgoing>F15</bpmn:outgoing><bpmn:outgoing>F16</bpmn:outgoing><bpmn:outgoing>F17</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:endEvent id="E_Rejected" name="Element rejected (reason recorded)"><bpmn:incoming>F14</bpmn:incoming></bpmn:endEvent>
<bpmn:userTask id="T_Approve" name="Approve exact record version"><bpmn:incoming>F15</bpmn:incoming><bpmn:incoming>F23</bpmn:incoming><bpmn:outgoing>F19</bpmn:outgoing></bpmn:userTask>
<bpmn:exclusiveGateway id="G_Guard" name="Approval accepted?"><bpmn:incoming>F19</bpmn:incoming><bpmn:outgoing>F20</bpmn:outgoing><bpmn:outgoing>F21</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:endEvent id="E_Approved" name="Element approved"><bpmn:incoming>F20</bpmn:incoming></bpmn:endEvent>
<bpmn:exclusiveGateway id="G_RefType" name="Refusal type?"><bpmn:incoming>F21</bpmn:incoming><bpmn:outgoing>F22</bpmn:outgoing><bpmn:outgoing>F23</bpmn:outgoing><bpmn:outgoing>F24</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:endEvent id="E_NoApprover" name="Element unresolved (no eligible approver)"><bpmn:incoming>F24</bpmn:incoming></bpmn:endEvent>
<bpmn:boundaryEvent id="BE_Propose" attachedToRef="T_Propose" cancelActivity="true"><bpmn:outgoing>F28</bpmn:outgoing><bpmn:errorEventDefinition id="EED_BE_Propose" errorRef="Err_Tech"/></bpmn:boundaryEvent>
<bpmn:boundaryEvent id="BE_Import" attachedToRef="T_Import" cancelActivity="true"><bpmn:outgoing>F29</bpmn:outgoing><bpmn:errorEventDefinition id="EED_BE_Import" errorRef="Err_Tech"/></bpmn:boundaryEvent>
<bpmn:boundaryEvent id="BE_Locate" attachedToRef="T_Locate" cancelActivity="true"><bpmn:outgoing>F30</bpmn:outgoing><bpmn:errorEventDefinition id="EED_BE_Locate" errorRef="Err_Tech"/></bpmn:boundaryEvent>
<bpmn:boundaryEvent id="BE_Checks" attachedToRef="T_Checks" cancelActivity="true"><bpmn:outgoing>F31</bpmn:outgoing><bpmn:errorEventDefinition id="EED_BE_Checks" errorRef="Err_Tech"/></bpmn:boundaryEvent>
<bpmn:sequenceFlow id="F1" sourceRef="Start" targetRef="T_Select"/>
<bpmn:sequenceFlow id="F2" sourceRef="T_Select" targetRef="G_Split"/>
<bpmn:sequenceFlow id="F3" name="document" sourceRef="G_Split" targetRef="T_Propose"/>
<bpmn:sequenceFlow id="F4" name="record" sourceRef="G_Split" targetRef="T_Import"/>
<bpmn:sequenceFlow id="F5" sourceRef="T_Propose" targetRef="G_Join"/>
<bpmn:sequenceFlow id="F6" sourceRef="T_Import" targetRef="G_Join"/>
<bpmn:sequenceFlow id="F7" sourceRef="G_Join" targetRef="T_Locate"/>
<bpmn:sequenceFlow id="F8" sourceRef="T_Locate" targetRef="G_Located"/>
<bpmn:sequenceFlow id="F9" name="yes" sourceRef="G_Located" targetRef="T_Checks"/>
<bpmn:sequenceFlow id="F10" name="no" sourceRef="G_Located" targetRef="SP_Assess"/>
<bpmn:sequenceFlow id="F11" sourceRef="T_Checks" targetRef="SP_Assess"/>
<bpmn:sequenceFlow id="F12" sourceRef="SP_Assess" targetRef="T_Review"/>
<bpmn:sequenceFlow id="F13" sourceRef="T_Review" targetRef="G_Decision"/>
<bpmn:sequenceFlow id="F14" name="reject" sourceRef="G_Decision" targetRef="E_Rejected"/>
<bpmn:sequenceFlow id="F15" name="accept" sourceRef="G_Decision" targetRef="T_Approve"/>
<bpmn:sequenceFlow id="F16" name="correct" sourceRef="G_Decision" targetRef="T_Correct"/>
<bpmn:sequenceFlow id="F17" name="not in the given sources" sourceRef="G_Decision" targetRef="T_Obtain"/>
<bpmn:sequenceFlow id="F18" name="re-locate" sourceRef="T_Correct" targetRef="T_Locate"/>
<bpmn:sequenceFlow id="F19" sourceRef="T_Approve" targetRef="G_Guard"/>
<bpmn:sequenceFlow id="F20" name="yes" sourceRef="G_Guard" targetRef="E_Approved"/>
<bpmn:sequenceFlow id="F21" name="no" sourceRef="G_Guard" targetRef="G_RefType"/>
<bpmn:sequenceFlow id="F22" name="record-side" sourceRef="G_RefType" targetRef="T_Review"/>
<bpmn:sequenceFlow id="F23" name="approver-side" sourceRef="G_RefType" targetRef="T_Approve"/>
<bpmn:sequenceFlow id="F24" name="none eligible" sourceRef="G_RefType" targetRef="E_NoApprover"/>
<bpmn:sequenceFlow id="F25" sourceRef="T_Obtain" targetRef="G_Obtained"/>
<bpmn:sequenceFlow id="F26" name="yes: new source" sourceRef="G_Obtained" targetRef="T_Select"/>
<bpmn:sequenceFlow id="F27" name="no" sourceRef="G_Obtained" targetRef="E_Unresolved"/>
<bpmn:sequenceFlow id="F28" sourceRef="BE_Propose" targetRef="T_TechFail"/>
<bpmn:sequenceFlow id="F29" sourceRef="BE_Import" targetRef="T_TechFail"/>
<bpmn:sequenceFlow id="F30" sourceRef="BE_Locate" targetRef="T_TechFail"/>
<bpmn:sequenceFlow id="F31" sourceRef="BE_Checks" targetRef="T_TechFail"/>
<bpmn:sequenceFlow id="F32" sourceRef="T_TechFail" targetRef="G_Retries"/>
<bpmn:sequenceFlow id="F33" name="yes: retry" sourceRef="G_Retries" targetRef="G_Split"/>
<bpmn:sequenceFlow id="F34" name="no" sourceRef="G_Retries" targetRef="T_DecideTech"/>
<bpmn:sequenceFlow id="F35" sourceRef="T_DecideTech" targetRef="G_TechDec"/>
<bpmn:sequenceFlow id="F36" name="retry later" sourceRef="G_TechDec" targetRef="T_TechFail"/>
<bpmn:sequenceFlow id="F37" name="correct" sourceRef="G_TechDec" targetRef="T_Correct"/>
<bpmn:sequenceFlow id="F38" name="end" sourceRef="G_TechDec" targetRef="E_UnresTech"/>
</bpmn:process>
