<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_9c" targetNamespace="http://example.org/dpp-prep">
<bpmn:collaboration id="Collab_Proc_Assess"><bpmn:participant id="Pool_Proc_Assess" name="Readiness step (called from Figure 9)" processRef="Proc_Assess" />
<bpmn:textAnnotation id="A1"><bpmn:text>Not applicable gives not required; cannot yet determine gives not yet assessed. Evidenced, Authorised and Current become met only through review, approval or a validity rule. Never returns ready by default.</bpmn:text></bpmn:textAnnotation>
<bpmn:association id="As_A1" sourceRef="S05" targetRef="A1" />
</bpmn:collaboration>
<bpmn:process id="Proc_Assess" isExecutable="false">
<bpmn:dataObject id="Obj_DO_Req" /><bpmn:dataObjectReference id="DO_Req" name="Requirement (version)" dataObjectRef="Obj_DO_Req" />
<bpmn:dataObject id="Obj_DO_Check" /><bpmn:dataObjectReference id="DO_Check" name="Check results" dataObjectRef="Obj_DO_Check" />
<bpmn:dataObject id="Obj_DO_Assess" /><bpmn:dataObjectReference id="DO_Assess" name="Readiness assessments" dataObjectRef="Obj_DO_Assess" />
<bpmn:startEvent id="S01" name="Checks done or no located evidence"><bpmn:outgoing>F1</bpmn:outgoing></bpmn:startEvent>
<bpmn:businessRuleTask id="S02" name="Decide if conditions apply (Table A)"><bpmn:incoming>F1</bpmn:incoming><bpmn:outgoing>F2</bpmn:outgoing><bpmn:dataInputAssociation id="DIa1"><bpmn:sourceRef>DO_Req</bpmn:sourceRef></bpmn:dataInputAssociation></bpmn:businessRuleTask>
<bpmn:scriptTask id="S03" name="Map check results"><bpmn:incoming>F2</bpmn:incoming><bpmn:outgoing>F3</bpmn:outgoing><bpmn:dataInputAssociation id="DIa2"><bpmn:sourceRef>DO_Check</bpmn:sourceRef></bpmn:dataInputAssociation></bpmn:scriptTask>
<bpmn:exclusiveGateway id="G_Q" name="Quality applicable?"><bpmn:incoming>F3</bpmn:incoming><bpmn:outgoing>F4</bpmn:outgoing><bpmn:outgoing>F5</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:businessRuleTask id="S04" name="Decide quality (Table B)"><bpmn:incoming>F4</bpmn:incoming><bpmn:outgoing>F6</bpmn:outgoing></bpmn:businessRuleTask>
<bpmn:exclusiveGateway id="G_QJ"><bpmn:incoming>F5</bpmn:incoming><bpmn:incoming>F6</bpmn:incoming><bpmn:outgoing>F7</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:serviceTask id="S05" name="Decide status per condition (Table C)"><bpmn:incoming>F7</bpmn:incoming><bpmn:outgoing>F8</bpmn:outgoing><bpmn:dataOutputAssociation id="DOa1"><bpmn:targetRef>DO_Assess</bpmn:targetRef></bpmn:dataOutputAssociation></bpmn:serviceTask>
<bpmn:endEvent id="S06" name="Assessments recorded (back to review)"><bpmn:incoming>F8</bpmn:incoming></bpmn:endEvent>
<bpmn:sequenceFlow id="F1" sourceRef="S01" targetRef="S02" />
<bpmn:sequenceFlow id="F2" sourceRef="S02" targetRef="S03" />
<bpmn:sequenceFlow id="F3" sourceRef="S03" targetRef="G_Q" />
<bpmn:sequenceFlow id="F4" name="yes" sourceRef="G_Q" targetRef="S04" />
<bpmn:sequenceFlow id="F5" name="no or undetermined" sourceRef="G_Q" targetRef="G_QJ" />
<bpmn:sequenceFlow id="F6" sourceRef="S04" targetRef="G_QJ" />
<bpmn:sequenceFlow id="F7" sourceRef="G_QJ" targetRef="S05" />
<bpmn:sequenceFlow id="F8" sourceRef="S05" targetRef="S06" />
</bpmn:process>
